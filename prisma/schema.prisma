generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  userCode  String    @unique @map("user_code") @db.VarChar(20)
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  role      Role
  status    Status
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model OperationsQueue {
  id            Int       @id @default(autoincrement())
  orderCode     String    @unique @map("order_code") @db.VarChar(50)
  title         String    @db.VarChar(255)
  description   String?
  actionType    String    @map("action_type") @db.VarChar(100)
  relatedEntity String    @map("related_entity") @db.VarChar(255)
  status        OpsStatus
  priority      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("operations_queue")
}

model SystemStatus {
  id          Int           @id @default(autoincrement())
  serviceName String        @map("service_name") @db.VarChar(100)
  status      ServiceStatus
  details     String?
  latencyMs   Int?          @map("latency_ms")
  cpuUsage    Int?          @map("cpu_usage")
  lastChecked DateTime      @default(now()) @map("last_checked")

  @@map("system_status")
}

model Statistics {
  id             Int             @id @default(autoincrement())
  statType       String          @map("stat_type") @db.VarChar(100)
  currentValue   String          @map("current_value") @db.VarChar(50)
  trendDirection TrendDirection? @map("trend_direction")
  trendValue     String?         @map("trend_value") @db.VarChar(50)
  period         String?         @db.VarChar(50)
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("statistics")
}

enum Role {
  Buyer
  Seller
  QC_Agent @map("QC Agent")
  Admin
}

enum Status {
  Active
  Locked
  Pending
  Suspended
}

enum OpsStatus {
  Pending_QC   @map("Pending QC")
  Hold
  Verification
  Review
}

enum ServiceStatus {
  Operational
  Warning
  Down
}

enum TrendDirection {
  up
  down
}
